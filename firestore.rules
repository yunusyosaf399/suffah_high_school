rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primary administrator is pinned to the school's existing Auth account.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'tQt6vca2zuagZipvknBwcmSRcrc2';
    }

    function isPrincipal() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'principal';
    }

    function accountPermission(key) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions',{}).get(key,true) == true;
    }

    function canManageAdmissions() {
      return isOwner() || isPrincipal();
    }

    // A teacher account must be linked to an existing active teacher profile
    // and use an email address explicitly saved on that profile.
    function validTeacherAccount(userId) {
      let staffId = request.resource.data.staffId;
      return staffId is string
        && exists(/databases/$(database)/documents/staff/$(staffId))
        && get(/databases/$(database)/documents/staff/$(staffId)).data.active == true
        && get(/databases/$(database)/documents/staff/$(staffId)).data.roleType == 'teacher'
        && request.resource.data.staffNo
          == get(/databases/$(database)/documents/staff/$(staffId)).data.staffNo
        && (
          request.resource.data.email
            == get(/databases/$(database)/documents/staff/$(staffId)).data.email
          || request.resource.data.email
            == get(/databases/$(database)/documents/staff/$(staffId)).data.get('alternateEmail', '')
        );
    }

    function isLinkedTeacher(staffId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffId == staffId
        && exists(/databases/$(database)/documents/staff/$(staffId))
        && get(/databases/$(database)/documents/staff/$(staffId)).data.active == true
        && get(/databases/$(database)/documents/staff/$(staffId)).data.roleType == 'teacher';
    }

    function canManageExams() {
      return isOwner() || (request.auth != null
        && activeExamAdministrator());
    }

    function activeExamAdministrator() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return user.active == true && (user.role == 'examiner' || (user.role == 'principal' && user.get('permissions',{}).get('principal_exams',true) == true));
    }

    function canCreateFormalTerm() {
      return isOwner() || (request.auth != null && principalCanSchedule());
    }
    function principalCanSchedule() {
      let user=get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return user.active == true && user.role == 'principal'
        && user.get('permissions',{}).get('principal_exams',true) == true;
    }
    function examAssignmentMatches(d) {
      let a = get(/databases/$(database)/documents/teacher_assignments/$(d.assignmentId)).data;
      return a.active == true && a.staffId == d.staffId
        && a.classId == d.classId && a.subject == d.subject;
    }

    match /exam_teacher_directory/{staffId} {
      allow read: if canManageExams();
      allow create, update: if canManageAdmissions()
        && request.resource.data.keys().hasOnly(['name', 'active'])
        && request.resource.data.name is string
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    function allowedNewRole() {
      return request.resource.data.role in
        ['principal', 'accountant', 'teacher', 'clerk', 'parent',
         'canteen_seller', 'inventory_manager', 'examiner'];
    }

    function hasTeacherClassAccess(classId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && isLinkedTeacher(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffId)
        && exists(/databases/$(database)/documents/teacher_class_links/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffId + '__' + classId))
        && get(/databases/$(database)/documents/teacher_class_links/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffId + '__' + classId)).data.active == true
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.active == true;
    }

    function validClassSubject(classId, subjectId, subjectName) {
      return exists(/databases/$(database)/documents/classes/$(classId)/subjects/$(subjectId))
        && get(/databases/$(database)/documents/classes/$(classId)/subjects/$(subjectId)).data.active == true
        && get(/databases/$(database)/documents/classes/$(classId)/subjects/$(subjectId)).data.name == subjectName;
    }

    function activeTeacherAssignment(assignmentId, staffId, classId, subject) {
      return exists(/databases/$(database)/documents/teacher_assignments/$(assignmentId))
        && get(/databases/$(database)/documents/teacher_assignments/$(assignmentId)).data.active == true
        && get(/databases/$(database)/documents/teacher_assignments/$(assignmentId)).data.staffId == staffId
        && get(/databases/$(database)/documents/teacher_assignments/$(assignmentId)).data.classId == classId
        && get(/databases/$(database)/documents/teacher_assignments/$(assignmentId)).data.subject == subject
        && (
          get(/databases/$(database)/documents/teacher_assignments/$(assignmentId)).data.get('subjectId', '') == ''
          || validClassSubject(classId,
            get(/databases/$(database)/documents/teacher_assignments/$(assignmentId)).data.subjectId, subject)
        )
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.active == true
        && isLinkedTeacher(staffId);
    }

    // A teacher's attendance class is independent of subject teaching.
    function canMarkClassAttendance(classId) {
      let staffId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffId;
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && isLinkedTeacher(staffId) && accountPermission('teacher_attendance')
        && exists(/databases/$(database)/documents/attendance_teacher_links/$(staffId))
        && get(/databases/$(database)/documents/attendance_teacher_links/$(staffId)).data.active == true
        && get(/databases/$(database)/documents/attendance_teacher_links/$(staffId)).data.classId == classId
        && exists(/databases/$(database)/documents/attendance_class_assignments/$(classId))
        && get(/databases/$(database)/documents/attendance_class_assignments/$(classId)).data.active == true
        && get(/databases/$(database)/documents/attendance_class_assignments/$(classId)).data.staffId == staffId
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.active == true;
    }

    // Validate the student, assigned class and same-day parent transaction.
    function validTeacherAttendanceMark(dayId, studentId) {
      return request.resource.data.classId is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dayId.matches('^' + request.resource.data.classId + '_[0-9]{8}$')
        && canMarkClassAttendance(request.resource.data.classId)
        && exists(/databases/$(database)/documents/class_rosters/$(request.resource.data.classId)/students/$(studentId))
        && get(/databases/$(database)/documents/class_rosters/$(request.resource.data.classId)/students/$(studentId)).data.active == true
        && getAfter(/databases/$(database)/documents/attendance_days/$(dayId)).data.classId == request.resource.data.classId
        && getAfter(/databases/$(database)/documents/attendance_days/$(dayId)).data.date == request.resource.data.date;
    }

    // Fetch each security document once. Marks rules must stay within
    // Firestore's per-operation document-access budget.
    function examTeacherAuthorized(d) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let staff = get(/databases/$(database)/documents/staff/$(d.staffId)).data;
      let assignment = get(/databases/$(database)/documents/teacher_assignments/$(d.assignmentId)).data;
      let schoolClass = get(/databases/$(database)/documents/classes/$(d.classId)).data;
      return user.active == true && user.role == 'teacher' && user.staffId == d.staffId
        && user.get('permissions',{}).get('teacher_academics',true) == true
        && staff.active == true && staff.roleType == 'teacher'
        && assignment.active == true && assignment.staffId == d.staffId
        && assignment.classId == d.classId && assignment.subject == d.subject
        && schoolClass.active == true
        && (assignment.get('subjectId', '') == ''
          || validClassSubject(d.classId, assignment.subjectId, d.subject));
    }

    function canMarkExam(examId) {
      let exam = get(/databases/$(database)/documents/examinations/$(examId)).data;
      return request.auth != null && exam.active == true
        && examTeacherAuthorized(exam);
    }

    function validExamMark(examId, studentId) {
      let exam = get(/databases/$(database)/documents/examinations/$(examId)).data;
      let roster = get(/databases/$(database)/documents/class_rosters/$(exam.classId)/students/$(studentId)).data;
      let mark = request.resource.data;
      return request.auth != null && exam.active == true
        && exam.get('resultStatus','draft') == 'draft'
        && examTeacherAuthorized(exam)
        && mark.examId == examId && mark.studentId == studentId
        && mark.teacherUid == request.auth.uid && mark.classId == exam.classId
        && mark.score is number && mark.score >= 0 && mark.score <= exam.maxMarks
        && (exam.get('cycleId','') == '' ? roster.active == true
          : (studentId in exam.expectedStudentIds && studentId in getAfter(paperPath(examId)).data.markedStudentIds));
    }

    // Generated obligations have no cash effect. Every paid balance must be
    // backed by exactly one atomic, append-only finance ledger receipt.
    function validFinanceBillCreate(billId) {
      return canManageAdmissions()
        && request.resource.data.billId == billId
        && request.resource.data.month is string
        && request.resource.data.category is string
        && request.resource.data.title is string
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.paidMinor == 0
        && request.resource.data.status == 'unpaid'
        && request.resource.data.currency == 'PKR'
        && request.resource.data.generatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validFinanceBillPayment(billId, sourceType) {
      let receipt = /databases/$(database)/documents/finance_ledger/$(request.resource.data.lastPaymentId);
      return canManageAdmissions()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paidMinor', 'status', 'updatedAt', 'updatedBy', 'lastPaymentId'])
        && request.resource.data.paidMinor is int
        && request.resource.data.paidMinor > resource.data.paidMinor
        && request.resource.data.paidMinor <= resource.data.amountMinor
        && request.resource.data.status ==
          (request.resource.data.paidMinor == resource.data.amountMinor
            ? 'paid' : 'partial')
        && request.resource.data.lastPaymentId is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && getAfter(receipt).data.sourceId == billId
        && getAfter(receipt).data.sourceType == sourceType
        && getAfter(receipt).data.createdBy == request.auth.uid
        && getAfter(receipt).data.amountMinor ==
          request.resource.data.paidMinor - resource.data.paidMinor;
    }

    function validFinanceLedgerBill(collectionName, entryId) {
      let bill = /databases/$(database)/documents/$(collectionName)/$(request.resource.data.sourceId);
      return exists(bill)
        && getAfter(bill).data.lastPaymentId == entryId
        && getAfter(bill).data.updatedBy == request.auth.uid
        && getAfter(bill).data.paidMinor - get(bill).data.paidMinor ==
          request.resource.data.amountMinor;
    }

    // Owner grants an immutable role through users/{uid}. Inventory manager
    // may manage catalog, stock receipts and adjustments. Sellers cannot
    // change prices, catalog metadata or stock except as part of a valid sale.
    function inventoryRole(role) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function canManageInventory() {
      return isOwner() || inventoryRole('inventory_manager');
    }

    function canSellInventory() {
      return canManageInventory() || inventoryRole('canteen_seller');
    }

    function validInventoryItem(itemId) {
      return request.resource.data.keys().hasOnly([
          'sku', 'name', 'department', 'unit', 'description', 'priceMinor',
          'stockQty', 'reorderPoint', 'active', 'currency',
          'lastMovementId', 'lastMovementType', 'createdBy', 'createdAt',
          'updatedBy', 'updatedAt',
          'category', 'subcategory', 'customType', 'classLevel',
          'bookSeries', 'subject', 'publisher', 'brand', 'variant',
          'expiryDate', 'archived', 'archivedBy', 'archivedAt'])
        && request.resource.data.sku == itemId
        && itemId.matches('^[A-Z0-9_-]{3,32}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.department in ['canteen', 'stationery']
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 24
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 250
        && request.resource.data.priceMinor is int
        && request.resource.data.priceMinor > 0
        && request.resource.data.priceMinor <= 100000000000
        && request.resource.data.stockQty is int
        && request.resource.data.stockQty >= 0
        && request.resource.data.stockQty <= 100000000
        && request.resource.data.reorderPoint is int
        && request.resource.data.reorderPoint >= 0
        && request.resource.data.active is bool
        && request.resource.data.currency == 'PKR'
        && request.resource.data.get('archived', false) is bool
        && request.resource.data.get('category', 'other') is string
        && request.resource.data.get('subcategory', 'other') is string
        && request.resource.data.get('archivedBy', '') is string;
    }

    function validInventorySaleMovement(itemId) {
      let event = /databases/$(database)/documents/inventory_sales/$(request.resource.data.lastMovementId);
      return request.resource.data.lastMovementType == 'sale'
        && request.resource.data.stockQty < resource.data.stockQty
        && resource.data.get('archived', false) == false
        && !exists(event)
        && getAfter(event).data.itemId == itemId
        && getAfter(event).data.sellerUid == request.auth.uid
        && getAfter(event).data.quantity ==
             resource.data.stockQty - request.resource.data.stockQty;
    }

    function validInventoryPurchaseMovement(itemId) {
      let event = /databases/$(database)/documents/inventory_purchases/$(request.resource.data.lastMovementId);
      return canManageInventory()
        && request.resource.data.lastMovementType == 'purchase'
        && request.resource.data.stockQty > resource.data.stockQty
        && !exists(event)
        && getAfter(event).data.itemId == itemId
        && getAfter(event).data.recordedBy == request.auth.uid
        && getAfter(event).data.quantity ==
             request.resource.data.stockQty - resource.data.stockQty;
    }

    function validInventoryAdjustmentMovement(itemId) {
      let event = /databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId);
      return canManageInventory()
        && request.resource.data.lastMovementType == 'adjustment'
        && request.resource.data.stockQty != resource.data.stockQty
        && !exists(event)
        && getAfter(event).data.itemId == itemId
        && getAfter(event).data.recordedBy == request.auth.uid
        && getAfter(event).data.delta ==
             request.resource.data.stockQty - resource.data.stockQty;
    }

    match /users/{userId} {
      // All accounts can read only their own school role; owner can list them.
      allow get: if isOwner()
        || (request.auth != null && request.auth.uid == userId);
      allow list: if isOwner();
      allow create: if isOwner()
        && userId != 'tQt6vca2zuagZipvknBwcmSRcrc2'
        && allowedNewRole()
        && request.resource.data.active == true && request.resource.data.get('removed',false) == false
        && validAccountPermissions(request.resource.data)
        && (request.resource.data.role != 'parent' || request.resource.data.get('linkedStudentIds',[]).size() > 0)
        && (
          request.resource.data.role != 'teacher'
          || validTeacherAccount(userId)
        );
      allow update: if isOwner()
        && userId != 'tQt6vca2zuagZipvknBwcmSRcrc2'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active','permissions','linkedStudentIds','removed','removedAt','updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && (resource.data.get('removed',false) == false ||
          (request.resource.data.get('removed',false) == true && request.resource.data.active == false))
        && (request.resource.data.get('removed',false) == false ||
          (request.resource.data.active == false && request.resource.data.removedAt is timestamp))
        && validAccountPermissions(request.resource.data);
      // Preserve role audit records and historical references.
      allow delete: if false;
    }
    function validAccountPermissions(d) {
      let p=d.get('permissions',{});
      let ids=d.get('linkedStudentIds',[]);
      return p is map && ids is list && ids.size() <= 50 && ids.toSet().size() == ids.size()
        && p.get('parent_profile',true) is bool
        && p.get('parent_fees',true) is bool
        && p.get('parent_attendance',true) is bool
        && p.get('parent_exams',true) is bool
        && p.get('parent_documents',true) is bool
        && p.get('messages',true) is bool
        && p.get('teacher_profile',true) is bool
        && p.get('teacher_payroll',true) is bool
        && p.get('teacher_academics',true) is bool
        && p.get('teacher_classwork',true) is bool
        && p.get('teacher_attendance',true) is bool
        && p.get('teacher_analytics',true) is bool
        && p.get('principal_exams',true) is bool
        && (d.role == 'parent' || ids.size() == 0)
        && ((d.role == 'parent' && p.keys().hasOnly(['parent_profile','parent_fees','parent_attendance','parent_exams','parent_documents','messages']))
          || (d.role == 'teacher' && p.keys().hasOnly(['teacher_profile','teacher_payroll','teacher_academics','teacher_classwork','teacher_attendance','teacher_analytics','messages']))
          || (d.role == 'principal' && p.keys().hasOnly(['principal_exams','messages']))
          || p.size() == 0);
    }
    match /staff_contracts/{staffId} {
      allow get: if canManageAdmissions() || (isLinkedTeacher(staffId) && accountPermission('teacher_profile'));
      allow list: if canManageAdmissions();
      allow create,update: if isOwner() && request.resource.data.keys().hasOnly(['type','startDate','endDate','details','updatedAt'])
        && request.resource.data.type is string && request.resource.data.type.size() <= 80
        && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/staff/$(staffId));
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if canManageAdmissions() || canManageExams();
      allow create, update: if canManageAdmissions();
      allow delete: if false;
    }

    // Owner-managed subject catalog, distinct for each class and section.
    match /classes/{classId}/subjects/{subjectId} {
      allow get, list: if canManageAdmissions() || canManageExams();
      allow create: if canManageAdmissions()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.active == true
        && request.resource.data.classId == classId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.nameKey is string
        && request.resource.data.code is string
        && request.resource.data.description is string
        && request.resource.data.weeklyPeriods is int
        && request.resource.data.weeklyPeriods >= 0
        && request.resource.data.weeklyPeriods <= 30
        && request.resource.data.active == true;
      allow update: if canManageAdmissions()
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameKey == resource.data.nameKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.code is string
        && request.resource.data.description is string
        && request.resource.data.weeklyPeriods is int
        && request.resource.data.weeklyPeriods >= 0
        && request.resource.data.weeklyPeriods <= 30
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read, create, update: if canManageAdmissions();
      allow delete: if false;
    }

    match /students/{studentId} {
      // School records are readable in this phase only by owner/principal.
      // Parent and teacher access needs verified child/class links later.
      allow read: if canManageAdmissions();

      // New admissions must begin as reserved drafts. Existing legacy IDs
      // can still be read/updated without changing their original numbers.
      allow create: if canManageAdmissions()
        && request.resource.data.admissionNo == studentId
        && request.resource.data.status == 'draft'
        && request.resource.data.rollNo is string
        && request.resource.data.rollNo.matches('[1-9][0-9]{4}');

      // After admission the record is locked against everyone except
      // the owner or principal, including clients bypassing the Flutter UI.
      // Never change immutable identity, family links, or creation time.
      allow update: if canManageAdmissions()
        && request.resource.data.get('admissionNo', studentId)
           == resource.data.get('admissionNo', studentId)
        && request.resource.data.get('rollNo', '')
           == resource.data.get('rollNo', '')
        && request.resource.data.get('parentUids', [])
           == resource.data.get('parentUids', [])
        && request.resource.data.get('createdAt', null)
           == resource.data.get('createdAt', null)
        && request.resource.data.get('status', 'admitted')
           in ['draft', 'admitted']
        && !(resource.data.get('status', 'admitted') == 'admitted'
          && request.resource.data.get('status', 'admitted') == 'draft');

      allow delete: if false;
    }

    // One designated attendance teacher per class; one class per teacher.
    // Only owner/principal may change either mapping.
    match /attendance_class_assignments/{classId} {
      allow get, list: if canManageAdmissions();
      allow create, update: if canManageAdmissions()
        && request.resource.data.classId == classId
        && request.resource.data.staffId is string
        && request.resource.data.className is string
        && request.resource.data.staffName is string
        && request.resource.data.active == true;
      allow delete: if canManageAdmissions();
    }

    match /attendance_teacher_links/{staffId} {
      allow get: if canManageAdmissions() || (isLinkedTeacher(staffId) && accountPermission('teacher_attendance'));
      allow list: if canManageAdmissions();
      allow create, update: if canManageAdmissions()
        && request.resource.data.staffId == staffId
        && request.resource.data.classId is string
        && request.resource.data.className is string
        && request.resource.data.staffName is string
        && request.resource.data.active == true;
      allow delete: if canManageAdmissions();
    }

    // Teachers cannot enumerate all attendance days. Their mark queries
    // must filter by their own assigned class ID.
    match /attendance_days/{dayId} {
      allow get: if canManageAdmissions()
        || (resource.data.classId is string
          && dayId.matches('^' + resource.data.classId + '_[0-9]{8}$')
          && canMarkClassAttendance(resource.data.classId));
      allow list: if canManageAdmissions();
      allow create: if (canManageAdmissions()
          || (request.resource.data.classId is string
            && request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && dayId.matches('^' + request.resource.data.classId + '_[0-9]{8}$')
            && canMarkClassAttendance(request.resource.data.classId)))
        && request.resource.data.classId is string
        && request.resource.data.date is string
        && request.resource.data.lastEditedBy == request.auth.uid;
      allow update: if (canManageAdmissions()
          || (resource.data.classId is string
            && dayId.matches('^' + resource.data.classId + '_[0-9]{8}$')
            && canMarkClassAttendance(resource.data.classId)))
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.date == resource.data.date
        && request.resource.data.lastEditedBy == request.auth.uid;
      allow delete: if false;

      match /marks/{studentId} {
        allow get, list: if canManageAdmissions()
          || (resource.data.classId is string
            && dayId.matches('^' + resource.data.classId + '_[0-9]{8}$')
            && canMarkClassAttendance(resource.data.classId));
        allow create: if (canManageAdmissions()
            || validTeacherAttendanceMark(dayId, studentId))
          && request.resource.data.studentId == studentId
          && request.resource.data.classId is string
          && request.resource.data.date is string
          && request.resource.data.status
            in ['present', 'absent', 'late', 'leave', 'unmarked']
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if (canManageAdmissions()
            || validTeacherAttendanceMark(dayId, studentId))
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.date == resource.data.date
          && request.resource.data.status
            in ['present', 'absent', 'late', 'leave', 'unmarked']
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // School staff directory; only owner/principal can view and modify it.
    match /staff/{staffId} {
      allow get: if canManageAdmissions() || (isLinkedTeacher(staffId) && accountPermission('teacher_profile'));
      allow list: if canManageAdmissions();
      allow create: if canManageAdmissions()
        && request.resource.data.staffNo == staffId
        && request.resource.data.active == true
        && request.resource.data.roleType
          in ['teacher', 'administration', 'office', 'support']
        && request.resource.data.fullName is string
        && request.resource.data.phone is string;
      allow update: if canManageAdmissions()
        && request.resource.data.staffNo == resource.data.staffNo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.roleType
          in ['teacher', 'administration', 'office', 'support']
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // One teacher-to-class-and-subject assignment per stable document ID.
    match /teacher_assignments/{assignmentId} {
      allow read: if canManageAdmissions() || canManageExams() || isLinkedTeacher(resource.data.staffId);
      allow create: if canManageAdmissions()
        && request.resource.data.staffId is string
        && request.resource.data.classId is string
        && request.resource.data.subject is string
        && request.resource.data.subjectId is string
        && validClassSubject(request.resource.data.classId,
          request.resource.data.subjectId, request.resource.data.subject)
        && request.resource.data.className is string
        && request.resource.data.active == true
        && exists(/databases/$(database)/documents/staff/$(request.resource.data.staffId))
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.roleType == 'teacher'
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.active == true;
      allow update: if canManageAdmissions()
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.subject == resource.data.subject
        && (
          request.resource.data.get('subjectId', '') == resource.data.get('subjectId', '')
          || (resource.data.get('subjectId', '') == ''
              && request.resource.data.subjectId is string
              && validClassSubject(resource.data.classId,
                request.resource.data.subjectId, resource.data.subject))
        )
        && request.resource.data.className is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active is bool
        && (
          request.resource.data.active == false
          || (
            exists(/databases/$(database)/documents/staff/$(resource.data.staffId))
            && exists(/databases/$(database)/documents/classes/$(resource.data.classId))
            && get(/databases/$(database)/documents/staff/$(resource.data.staffId)).data.active == true
            && get(/databases/$(database)/documents/staff/$(resource.data.staffId)).data.roleType == 'teacher'
            && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.active == true
            && (resource.data.get('subjectId', '') == ''
              || validClassSubject(resource.data.classId, resource.data.subjectId, resource.data.subject))
          )
        );
      allow delete: if false;
    }

    // One-time migration markers are administrator-only.
    match /system_migrations/{migrationId} {
      allow read, create, update: if canManageAdmissions();
      allow delete: if false;
    }

    // Teachers can read only the class/subject assignments linked to their
    // own active staff profile. Assignment creation remains owner/principal.
    match /teacher_class_links/{linkId} {
      allow read: if canManageAdmissions() || isLinkedTeacher(resource.data.staffId);
      allow create, update: if canManageAdmissions()
        && request.resource.data.staffId is string
        && request.resource.data.classId is string
        && request.resource.data.active is bool
        && request.resource.data.assignmentIds is list;
      allow delete: if false;
    }

    // Safe roster projection: names and roll numbers only, never guardian,
    // contact, address or health details from the student record.
    match /class_rosters/{classId}/students/{studentId} {
      allow get, list: if canManageAdmissions() || canManageExams()
        || (resource.data.active == true
          && (hasTeacherClassAccess(classId) || canMarkClassAttendance(classId)));
      allow create, update: if canManageAdmissions()
        && request.resource.data.studentId == studentId
        && request.resource.data.classId == classId
        && request.resource.data.fullName is string
        && request.resource.data.rollNo is string
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // Teacher-created assignments and homework are scoped to an active
    // teacher/class/subject assignment and the authenticated linked teacher.
    match /classwork/{workId} {
      allow get,list: if request.auth != null && parentCurrentClassAccess(resource.data.classId);
      allow get, list: if canManageExams() || (isLinkedTeacher(resource.data.staffId) && accountPermission('teacher_classwork'));
      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.active == true
        && (
          (canManageExams() && request.resource.data.kind == 'assignment'
            && examAssignmentMatches(request.resource.data))
          || (request.resource.data.kind in ['assignment', 'homework']
            && isLinkedTeacher(request.resource.data.staffId) && accountPermission('teacher_classwork')
            && activeTeacherAssignment(request.resource.data.assignmentId,
              request.resource.data.staffId, request.resource.data.classId,
              request.resource.data.subject))
        );
      allow update: if (canManageExams()
          || (isLinkedTeacher(resource.data.staffId) && accountPermission('teacher_classwork')
            && resource.data.teacherUid == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'instructions', 'dueDate', 'active', 'updatedAt']);
      allow delete: if false;
    }

    function termCyclePath(id) {
      return /databases/$(database)/documents/exam_term_cycles/$(id);
    }
    function termControlPath() {
      return /databases/$(database)/documents/exam_term_control/current;
    }
    function paperPath(id) {
      return /databases/$(database)/documents/examinations/$(id);
    }
    function validPaperTimes(d) {
      return d.startMinute is int && d.endMinute is int
        && d.startMinute >= 0 && d.endMinute < 1440 && d.endMinute > d.startMinute
        && d.durationMinutes == d.endMinute - d.startMinute
        && d.durationMinutes <= 600 && d.endAt is timestamp;
    }
    function termIdMatches(id,d) {
      return d.academicYear is int && d.academicYear >= 2000 && d.academicYear <= 2100
        && ((d.category == 'First Term' && id == string(d.academicYear) + '_first')
          || (d.category == 'Mid Term' && id == string(d.academicYear) + '_mid')
          || (d.category == 'Final Term' && id == string(d.academicYear) + '_final'));
    }
    function validTermStart(id,d) {
      return termIdMatches(id,d) && d.status == 'active'
        && d.createdBy == request.auth.uid && d.createdAt == request.time
        && d.updatedAt == request.time && d.title is string
        && d.startDate is string && d.endDate is string && d.startDate <= d.endDate
        && d.excludedDates is map && d.skipSunday is bool
        && d.plannedClassIds is list && d.plannedClassIds.size() > 0
        && d.classIds is list && d.classIds.size() == 1
        && d.classIds[0] == d.lastClassId && d.lastClassId in d.plannedClassIds
        && d.paperIds is list && d.paperIds.size() >= 1 && d.paperIds.size() <= 15
        && d.paperIds.toSet().size() == d.paperIds.size()
        && d.releasedPaperIds == [] && d.slots is map
        && d.slots.size() == d.paperIds.size()
        && getAfter(termControlPath()).data.cycleId == id;
    }
    function termControlChange() {
      let id = request.resource.data.cycleId;
      return canCreateFormalTerm() && request.resource.data.keys().hasOnly(['cycleId','updatedAt'])
        && id is string && request.resource.data.updatedAt == request.time
        && !exists(termCyclePath(id))
        && getAfter(termCyclePath(id)).data.status == 'active';
    }
    match /exam_term_control/{key} {
      allow read: if canManageExams();
      allow create: if key == 'current' && termControlChange();
      allow update: if key == 'current' && termControlChange()
        && get(termCyclePath(resource.data.cycleId)).data.status == 'closed';
      allow delete: if false;
    }
    function appendTermClass(old,d) {
      return d.diff(old).affectedKeys().hasOnly(['classIds','paperIds','slots','lastClassId','updatedAt'])
        && d.classIds.toSet() == old.classIds.toSet().union([d.lastClassId].toSet())
        && d.classIds.size() == old.classIds.size()+1
        && d.lastClassId in old.plannedClassIds && !(d.lastClassId in old.classIds)
        && d.paperIds.hasAll(old.paperIds) && d.paperIds.toSet().size() == d.paperIds.size()
        && d.paperIds.size() > old.paperIds.size() && d.paperIds.size() <= old.paperIds.size()+15
        && d.slots.diff(old.slots).removedKeys().size() == 0
        && d.slots.diff(old.slots).changedKeys().size() == 0
        && d.slots.size() - old.slots.size() == d.paperIds.size() - old.paperIds.size();
    }
    function termResultChange(id,old,d) {
      let paperId=d.lastPaperId;
      let before=get(paperPath(paperId)).data;
      let after=getAfter(paperPath(paperId)).data;
      return d.diff(old).affectedKeys().hasOnly(['releasedPaperIds','lastPaperId','updatedAt'])
        && paperId in old.paperIds && before.cycleId == id && after.cycleId == id
        && before.resultStatus != after.resultStatus
        && ((after.resultStatus == 'released' && before.resultStatus == 'submitted'
            && d.releasedPaperIds.toSet() == old.releasedPaperIds.toSet().union([paperId].toSet()))
          || (after.resultStatus == 'draft' && before.resultStatus in ['submitted','released']
            && d.releasedPaperIds.toSet() == old.releasedPaperIds.toSet().difference([paperId].toSet())))
        && d.releasedPaperIds.toSet().size() == d.releasedPaperIds.size();
    }
    function termReschedule(id,old,d) {
      let paperId=d.lastPaperId;
      let before=get(paperPath(paperId)).data;
      let after=getAfter(paperPath(paperId)).data;
      let from=before.classId+'__'+before.examDate;
      let to=after.classId+'__'+after.examDate;
      return d.diff(old).affectedKeys().hasOnly(['slots','endDate','lastPaperId','updatedAt'])
        && paperId in old.paperIds && before.cycleId == id && after.cycleId == id
        && before.resultStatus == 'draft' && after.resultStatus == 'draft'
        && old.slots[from] == paperId && d.slots[to] == paperId
        && (from == to || (!(to in old.slots) && !(from in d.slots)))
        && d.slots.size() == old.slots.size()
        && d.slots.diff(old.slots).affectedKeys().hasOnly([from,to])
        && d.endDate == (after.examDate > old.endDate ? after.examDate : old.endDate);
    }
    function termCanClose(old,d) {
      return d.diff(old).affectedKeys().hasOnly(['status','closedBy','closedAt','updatedAt'])
        && d.status == 'closed' && d.closedBy == request.auth.uid && d.closedAt == request.time
        && old.paperIds.size() > 0 && old.plannedClassIds.size() > 0
        && old.classIds.toSet() == old.plannedClassIds.toSet()
        && old.releasedPaperIds.toSet() == old.paperIds.toSet();
    }
    match /exam_term_cycles/{id} {
      allow read: if canManageExams();
      allow create: if canCreateFormalTerm() && validTermStart(id,request.resource.data);
      allow update: if canManageExams() && resource.data.status == 'active'
        && request.resource.data.updatedAt == request.time
        && ((canCreateFormalTerm() && appendTermClass(resource.data,request.resource.data))
          || termCanClose(resource.data,request.resource.data)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excludedDates','updatedAt'])
            && request.resource.data.excludedDates is map)
          || termResultChange(id,resource.data,request.resource.data)
          || termReschedule(id,resource.data,request.resource.data));
      allow delete: if false;
    }
    function validManagedPaper(examId,d) {
      let cycle=getAfter(termCyclePath(d.cycleId)).data;
      return d.kind == 'term' && cycle.status == 'active' && cycle.category == d.category
        && d.classId == cycle.lastClassId && d.classId in cycle.classIds
        && examId in cycle.paperIds && cycle.slots[d.classId+'__'+d.examDate] == examId
        && d.examDate >= cycle.startDate && d.examDate <= cycle.endDate
        && !(d.examDate in cycle.excludedDates)
        && d.expectedStudentIds is list && d.expectedStudentIds.size() > 0
        && d.expectedStudentIds.size() <= 1000
        && d.expectedStudentIds.toSet().size() == d.expectedStudentIds.size()
        && d.rosterSnapshot is map && d.rosterSnapshot.keys().toSet() == d.expectedStudentIds.toSet()
        && d.markedStudentIds == [] && validPaperTimes(d);
    }
    function managedPaperStatus(examId,old,d) {
      let cycle=getAfter(termCyclePath(old.cycleId)).data;
      return cycle.status == 'active' && examId in cycle.paperIds
        && d.diff(old).affectedKeys().hasOnly(['resultStatus','updatedAt'])
        && ((d.resultStatus == 'released' && old.resultStatus == 'submitted'
          && old.expectedStudentIds.toSet() == old.markedStudentIds.toSet()
          && request.time >= old.endAt && !(old.examDate in cycle.excludedDates)
          && examId in cycle.releasedPaperIds)
        || (d.resultStatus == 'draft' && old.resultStatus in ['submitted','released']
          && !(examId in cycle.releasedPaperIds)));
    }
    function managedPaperReschedule(examId,old,d) {
      let cycle=getAfter(termCyclePath(old.cycleId)).data;
      return cycle.status == 'active' && old.resultStatus == 'draft' && old.markedStudentIds.size() == 0
        && d.diff(old).affectedKeys().hasOnly(['examDate','startMinute','endMinute','durationMinutes',
          'endAt','endDate','rescheduleReason','rescheduleHistory','updatedAt'])
        && validPaperTimes(d) && d.endAt > request.time
        && d.examDate >= cycle.startDate && d.examDate <= cycle.endDate
        && !(d.examDate in cycle.excludedDates)
        && cycle.slots[d.classId+'__'+d.examDate] == examId
        && d.endDate == cycle.endDate
        && d.rescheduleReason is string && d.rescheduleReason.size() > 0 && d.rescheduleReason.size() <= 200
        && d.rescheduleHistory is list
        && d.rescheduleHistory.size() == old.get('rescheduleHistory',[]).size()+1
        && d.rescheduleHistory.hasAll(old.get('rescheduleHistory',[]));
    }
    function managedMarkedStudent(examId,old,d) {
      let studentId=d.lastMarkedStudentId;
      let mark=getAfter(/databases/$(database)/documents/examinations/$(examId)/marks/$(studentId)).data;
      return old.resultStatus == 'draft' && old.active == true
        && examTeacherAuthorized(old)
        && d.diff(old).affectedKeys().hasOnly(['markedStudentIds','lastMarkedStudentId','updatedAt'])
        && studentId in old.expectedStudentIds
        && d.markedStudentIds.toSet() == old.markedStudentIds.toSet().union([studentId].toSet())
        && d.markedStudentIds.toSet().size() == d.markedStudentIds.size()
        && mark.examId == examId && mark.studentId == studentId
        && mark.classId == old.classId && mark.teacherUid == request.auth.uid
        && mark.score is number && mark.score >= 0 && mark.score <= old.maxMarks;
    }

    match /examinations/{examId} {
      allow get, list: if canManageExams()
        || (resource.data.active == true && isLinkedTeacher(resource.data.staffId) && accountPermission('teacher_academics'));
      allow create: if request.auth != null
        && request.resource.data.assignmentId is string
        && request.resource.data.staffId is string
        && request.resource.data.classId is string
        && request.resource.data.subject is string
        && request.resource.data.title is string
        && request.resource.data.maxMarks is number
        && request.resource.data.maxMarks > 0
        && request.resource.data.maxMarks <= 1000
        && request.resource.data.active == true
        && request.resource.data.get('resultStatus', 'draft') == 'draft'
        && examAssignmentMatches(request.resource.data)
        && (request.resource.data.get('kind','term') == 'test' || validManagedPaper(examId,request.resource.data))
        && ((request.resource.data.get('kind','term') != 'test' && canCreateFormalTerm())
          || (request.resource.data.kind == 'test' && canManageExams())
          || (request.resource.data.kind == 'test'
            && request.resource.data.createdBy == request.auth.uid
            && examTeacherAuthorized(request.resource.data)))
        && (
          !('sessionId' in request.resource.data)
          || (request.resource.data.kind in ['term','test']
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.startDate is string
            && request.resource.data.endDate is string
            && request.resource.data.examDate is string
            && request.resource.data.startDate <= request.resource.data.examDate
            && request.resource.data.examDate <= request.resource.data.endDate
            && request.resource.data.paperType in ['Theory', 'Practical / Lab', 'Oral']
            && request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 1
            && request.resource.data.durationMinutes <= 600
            && ((request.resource.data.kind == 'term' &&
                request.resource.data.category in ['First Term','Mid Term','Final Term'])
              || (request.resource.data.kind == 'test' &&
                request.resource.data.category in ['Monthly Test','Weekly Test','Unit Test','Quiz','Other Test'])))
        );
      allow update: if (resource.data.get('cycleId','') != '' && request.auth != null
          && ((canManageExams() && (managedPaperStatus(examId,resource.data,request.resource.data)
            || managedPaperReschedule(examId,resource.data,request.resource.data)))
            || managedMarkedStudent(examId,resource.data,request.resource.data))) || (
          resource.data.get('cycleId','') == '' && canManageExams()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active','resultStatus','updatedAt'])
          && request.resource.data.active is bool
          && (request.resource.data.get('resultStatus','draft') == resource.data.get('resultStatus','draft')
            || request.resource.data.get('resultStatus','draft') == 'draft'
            || (resource.data.get('resultStatus','draft') == 'submitted'
              && request.resource.data.resultStatus == 'released'))
        ) || (
          request.auth != null && resource.data.active == true
          && examTeacherAuthorized(resource.data)
          && resource.data.get('resultStatus','draft') == 'draft'
          && (resource.data.get('cycleId','') == '' || (resource.data.expectedStudentIds.toSet() == resource.data.markedStudentIds.toSet()
            && request.time >= resource.data.endAt))
          && request.resource.data.resultStatus == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resultStatus','submittedBy','submittedAt','updatedAt'])
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.submittedAt == request.time
          && request.resource.data.updatedAt == request.time
        );
      allow delete: if false;

      match /marks/{studentId} {
        allow get, list: if canManageExams() || canMarkExam(examId);
        allow get: if parentFeature(studentId,'parent_exams')
          && get(paperPath(examId)).data.active == true
          && get(paperPath(examId)).data.resultStatus == 'released';
        allow create, update: if validExamMark(examId, studentId);
        allow delete: if false;
      }
    }

    // Payroll redesign is deferred. Preserve historical documents privately,
    // but block new financial records and disable teacher access meanwhile.
    match /payroll_records/{payrollId} {
      allow get, list: if canManageAdmissions();
      allow create, update, delete: if false;
    }

    // Finance setup: the tuition class rate is owner-only and the initial
    // creation timestamp cannot be rewritten. Other setup is admin-scoped.
    match /finance_tuition_rates/{classId} {
      allow get, list: if canManageAdmissions();
      allow create: if isOwner()
        && request.resource.data.classId == classId
        && request.resource.data.className is string
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currency == 'PKR'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && exists(/databases/$(database)/documents/classes/$(classId));
      allow update: if isOwner()
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currency == 'PKR'
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /finance_transport_rates/{studentId} {
      allow get, list: if canManageAdmissions();
      allow create, update: if canManageAdmissions()
        && request.resource.data.studentId == studentId
        && request.resource.data.studentName is string
        && request.resource.data.classId is string
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor >= 0
        && request.resource.data.active ==
          (request.resource.data.amountMinor > 0)
        && request.resource.data.currency == 'PKR'
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /finance_salary_rates/{staffId} {
      allow get: if canManageAdmissions() || (isLinkedTeacher(staffId) && accountPermission('teacher_payroll'));
      allow list: if canManageAdmissions();
      allow create, update: if canManageAdmissions()
        && request.resource.data.staffId == staffId
        && request.resource.data.staffName is string
        && request.resource.data.basicMinor is int
        && request.resource.data.basicMinor > 0
        && request.resource.data.allowanceMinor is int
        && request.resource.data.allowanceMinor >= 0
        && request.resource.data.bonusMinor is int
        && request.resource.data.bonusMinor >= 0
        && request.resource.data.amountMinor ==
          request.resource.data.basicMinor
          + request.resource.data.allowanceMinor
          + request.resource.data.bonusMinor
        && request.resource.data.currency == 'PKR'
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /finance_recurring_plans/{planId} {
      allow get, list: if canManageAdmissions();
      allow create, update: if canManageAdmissions()
        && request.resource.data.planId == planId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && request.resource.data.subcategory is string
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.scheduleDay is int
        && request.resource.data.scheduleDay >= 1
        && request.resource.data.scheduleDay <= 27
        && request.resource.data.active is bool
        && request.resource.data.automaticEnabled is bool
        && request.resource.data.currency == 'PKR'
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /finance_generation_settings/{category} {
      allow get, list: if canManageAdmissions();
      allow create, update: if canManageAdmissions()
        && category in ['tuition', 'transport', 'salary']
        && request.resource.data.category == category
        && request.resource.data.scheduleDay is int
        && request.resource.data.scheduleDay >= 1
        && request.resource.data.scheduleDay <= 27
        && request.resource.data.automaticEnabled is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Written exclusively by trusted Firebase Admin SDK worker.
    // Client owners/principals may inspect recent heartbeat and audit runs,
    // but never forge deployment status or scheduler completion.
    match /finance_scheduler_runtime/{statusId} {
      allow get: if canManageAdmissions() && statusId == 'status';
      allow list, create, update, delete: if false;
    }

    match /finance_scheduler_runs/{runId} {
      allow get, list: if canManageAdmissions();
      allow create, update, delete: if false;
    }

    // A generated student bill does NOT record any money received.
    match /finance_fee_bills/{billId} {
      allow get, list: if canManageAdmissions() || parentFeature(resource.data.studentId,'parent_fees');
      allow create: if validFinanceBillCreate(billId)
        && request.resource.data.category
          in ['tuition', 'transport', 'one_time']
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.classId is string;
      allow update: if validFinanceBillPayment(billId, 'fee');
      allow delete: if false;
    }

    match /finance_salary_bills/{billId} {
      allow get, list: if canManageAdmissions() || (isLinkedTeacher(resource.data.staffId) && accountPermission('teacher_payroll'));
      allow create: if validFinanceBillCreate(billId)
        && request.resource.data.category == 'salary'
        && request.resource.data.staffId is string
        && request.resource.data.staffName is string
        && request.resource.data.basicMinor is int
        && request.resource.data.allowanceMinor is int
        && request.resource.data.bonusMinor is int
        && request.resource.data.amountMinor ==
          request.resource.data.basicMinor
          + request.resource.data.allowanceMinor
          + request.resource.data.bonusMinor;
      allow update: if validFinanceBillPayment(billId, 'salary');
      allow delete: if false;
    }

    match /finance_recurring_bills/{billId} {
      allow get, list: if canManageAdmissions();
      allow create: if validFinanceBillCreate(billId)
        && request.resource.data.category == 'expense'
        && request.resource.data.planId is string;
      allow update: if validFinanceBillPayment(billId, 'recurring_expense');
      allow delete: if false;
    }

    // CREDIT is cash collected; DEBIT is cash paid. No update or delete is
    // allowed. The transaction must reconcile with its bill in the same
    // atomic Firestore transaction, except for direct expenses.
    match /finance_ledger/{entryId} {
      allow get, list: if canManageAdmissions() || (resource.data.sourceType == 'fee' && resource.data.direction == 'credit' && parentFeature(resource.data.studentId,'parent_fees'));
      allow create: if canManageAdmissions()
        && request.resource.data.entryId == entryId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currency == 'PKR'
        && request.resource.data.postedMonth is string
        && request.resource.data.sourceId is string
        && request.resource.data.category is string
        && request.resource.data.payerName is string
        && request.resource.data.recipientName is string
        && (request.resource.data.direction != 'credit'
          || request.resource.data.payerName.size() > 0)
        && request.resource.data.method
          in ['Cash', 'Bank Transfer', 'Bank Deposit', 'Easypaisa', 'JazzCash', 'Other']
        && (
          (request.resource.data.sourceType == 'fee'
            && request.resource.data.direction == 'credit'
            && request.resource.data.category
              in ['tuition', 'transport', 'one_time']
            && validFinanceLedgerBill('finance_fee_bills', entryId))
          || (request.resource.data.sourceType == 'salary'
            && request.resource.data.direction == 'debit'
            && request.resource.data.category == 'salary'
            && validFinanceLedgerBill('finance_salary_bills', entryId))
          || (request.resource.data.sourceType == 'recurring_expense'
            && request.resource.data.direction == 'debit'
            && request.resource.data.category == 'expense'
            && validFinanceLedgerBill('finance_recurring_bills', entryId))
          || (request.resource.data.sourceType == 'direct_expense'
            && request.resource.data.direction == 'debit'
            && request.resource.data.category == 'expense'
            && request.resource.data.sourceId == entryId)
        );
      allow update, delete: if false;
    }

    // Each administrator may store only their own dashboard card choices.
    match /finance_dashboard_preferences/{userId} {
      allow get: if canManageAdmissions()
        && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if canManageAdmissions()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.visibleCards is list
        && request.resource.data.rotate is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Price and stock are not trusted from the seller's device. A sale
    // requires a matching stock decrement in the SAME atomic transaction.
    // Inventory sellers only see this deliberately restricted projection,
    // never the students collection with guardian/health data.
    match /inventory_student_directory/{studentId} {
      allow get, list: if canSellInventory();
      allow create, update: if canManageAdmissions()
        && request.resource.data.keys().hasOnly([
          'studentId', 'fullName', 'rollNo', 'classId', 'active', 'updatedAt'])
        && request.resource.data.studentId == studentId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.rollNo is string
        && request.resource.data.classId is string
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(studentId))
        && request.resource.data.fullName ==
          getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('fullName', '')
        && request.resource.data.rollNo ==
          getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('rollNo', '')
        && request.resource.data.classId ==
          getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('classId', '')
        && request.resource.data.active ==
          (getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'admitted') == 'admitted'
          && getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('active', true) == true);
      allow delete: if false;
    }

    match /inventory_items/{itemId} {
      allow get, list: if canSellInventory();
      allow create: if canManageInventory()
        && validInventoryItem(itemId)
        && request.resource.data.active == true
        && request.resource.data.get('archived', false) == false
        && (
          (request.resource.data.stockQty == 0
            && request.resource.data.lastMovementId == ''
            && request.resource.data.lastMovementType == '')
          ||
          (request.resource.data.stockQty > 0
            && request.resource.data.lastMovementType == 'opening'
            && request.resource.data.lastMovementId is string
            && !exists(/databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId))
            && getAfter(/databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId)).data.itemId == itemId
            && getAfter(/databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId)).data.recordedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId)).data.stockBefore == 0
            && getAfter(/databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId)).data.delta == request.resource.data.stockQty
            && getAfter(/databases/$(database)/documents/inventory_adjustments/$(request.resource.data.lastMovementId)).data.reason == 'opening')
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if validInventoryItem(itemId)
        && request.resource.data.sku == resource.data.sku
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          // Managers can edit catalog data, but not silently change stock.
          (canManageInventory()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'department', 'unit', 'description',
                         'priceMinor', 'reorderPoint', 'active',
                         'category', 'subcategory', 'customType',
                         'classLevel', 'bookSeries', 'subject', 'publisher',
                         'brand', 'variant', 'expiryDate',
                         'archived', 'archivedAt', 'archivedBy',
                         'updatedAt', 'updatedBy'])
            && request.resource.data.stockQty == resource.data.stockQty
            && (!request.resource.data.get('archived', false)
                || (request.resource.data.active == false
                    && request.resource.data.archivedBy == request.auth.uid
                    && request.resource.data.archivedAt == request.time)))
          ||
          (canManageInventory()
            && resource.data.get('archived', false) == false
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'department', 'unit', 'description',
                         'priceMinor', 'reorderPoint', 'active',
                         'category', 'subcategory', 'customType',
                         'classLevel', 'bookSeries', 'subject', 'publisher',
                         'brand', 'variant', 'expiryDate',
                         'stockQty', 'lastMovementId', 'lastMovementType',
                         'updatedAt', 'updatedBy'])
            && request.resource.data.stockQty != resource.data.stockQty
            && request.resource.data.lastMovementId != resource.data.lastMovementId
            && validInventoryAdjustmentMovement(itemId))
          ||
          // All stock changes must be reconciled with an append-only event.
          (canSellInventory()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stockQty', 'lastMovementId', 'lastMovementType',
                         'updatedAt', 'updatedBy'])
            && request.resource.data.stockQty != resource.data.stockQty
            && resource.data.get('archived', false) == false
            && request.resource.data.lastMovementId is string
            && request.resource.data.lastMovementId != ''
            && request.resource.data.lastMovementId != resource.data.lastMovementId
            && (
              validInventorySaleMovement(itemId)
              || validInventoryPurchaseMovement(itemId)
              || validInventoryAdjustmentMovement(itemId)
            ))
        );
      allow delete: if false;
    }

    match /inventory_sales/{saleId} {
      allow get,list: if resource.data.customerType == 'student' && parentFeature(resource.data.customerId,'parent_fees');
      allow get: if canManageInventory() || isPrincipal()
        || (inventoryRole('canteen_seller')
            && resource.data.sellerUid == request.auth.uid);
      allow list: if canManageInventory() || isPrincipal()
        || (inventoryRole('canteen_seller')
            && resource.data.sellerUid == request.auth.uid);
      allow create: if canSellInventory()
        && request.resource.data.keys().hasOnly([
           'saleId', 'itemId', 'itemName', 'department',
           'quantity', 'stockBefore', 'unitPriceMinor', 'totalMinor',
           'currency', 'sellerUid', 'paymentMethod', 'soldAt',
           'orderId', 'lineNumber', 'customerType', 'customerId',
           'customerName', 'customerPhone', 'customerClass', 'customerRollNo',
           'paidMinor', 'paymentStatus', 'lastPaymentId', 'lastPaymentAt'])
        && request.resource.data.saleId == saleId
        && request.resource.data.itemId is string
        && exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 100
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.soldAt == request.time
        && request.resource.data.currency == 'PKR'
        && request.resource.data.paymentMethod in
            ['Cash', 'Easypaisa', 'JazzCash', 'Bank Transfer', 'Other', 'Unpaid']
        && (
          (!('orderId' in request.resource.data)
            && request.resource.data.paymentMethod != 'Unpaid')
          ||
          (
            request.resource.data.orderId is string
            && request.resource.data.orderId.size() >= 8
            && request.resource.data.orderId.size() <= 64
            && request.resource.data.lineNumber is int
            && request.resource.data.lineNumber >= 1
            && request.resource.data.lineNumber <= 6
            && request.resource.data.customerType in ['student', 'teacher', 'other']
            && request.resource.data.customerId is string
            && request.resource.data.customerName is string
            && request.resource.data.customerName.size() >= 2
            && request.resource.data.customerName.size() <= 100
            && request.resource.data.customerPhone is string
            && request.resource.data.customerPhone.size() <= 30
            && request.resource.data.customerClass is string
            && request.resource.data.customerRollNo is string
            && request.resource.data.lastPaymentId == ''
            && request.resource.data.paidMinor is int
            && request.resource.data.paidMinor in [0, request.resource.data.totalMinor]
            && request.resource.data.paymentStatus ==
               (request.resource.data.paidMinor == 0 ? 'borrowed' : 'paid')
            && (
              (request.resource.data.paidMinor == 0
                && request.resource.data.paymentMethod == 'Unpaid')
              || (request.resource.data.paidMinor > 0
                && request.resource.data.paymentMethod != 'Unpaid')
            )
            && (
              (request.resource.data.customerType == 'other'
                && request.resource.data.customerId == ''
                && request.resource.data.customerClass == ''
                && request.resource.data.customerRollNo == ''
                && (request.resource.data.paidMinor != 0
                  || request.resource.data.customerPhone.size() > 0))
              ||
              (request.resource.data.customerType == 'student'
                && request.resource.data.customerPhone == ''
                && request.resource.data.customerId.size() > 0
                && exists(/databases/$(database)/documents/inventory_student_directory/$(request.resource.data.customerId))
                && get(/databases/$(database)/documents/inventory_student_directory/$(request.resource.data.customerId)).data.active == true
                && request.resource.data.customerName ==
                   get(/databases/$(database)/documents/inventory_student_directory/$(request.resource.data.customerId)).data.fullName
                && request.resource.data.customerClass ==
                   get(/databases/$(database)/documents/inventory_student_directory/$(request.resource.data.customerId)).data.classId
                && request.resource.data.customerRollNo ==
                   get(/databases/$(database)/documents/inventory_student_directory/$(request.resource.data.customerId)).data.rollNo)
              ||
              // Paid, anonymous-by-name quick canteen checkout. Student,
              // Teacher and Other are category labels, not account IDs.
              (request.resource.data.department == 'canteen'
                && request.resource.data.customerType in ['student', 'teacher', 'other']
                && request.resource.data.customerId == ''
                && request.resource.data.customerPhone == ''
                && request.resource.data.customerClass == ''
                && request.resource.data.customerRollNo == ''
                && request.resource.data.paidMinor == request.resource.data.totalMinor
                && request.resource.data.paymentStatus == 'paid'
                && request.resource.data.paymentMethod != 'Unpaid'
                && request.resource.data.customerName ==
                  (request.resource.data.customerType == 'student' ? 'Student'
                    : request.resource.data.customerType == 'teacher' ? 'Teacher' : 'Other'))
            )
          )
        )
        && request.resource.data.itemName ==
           get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.name
        && request.resource.data.department ==
           get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.department
        && get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.active == true
        && get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.get('archived', false) == false
        && request.resource.data.stockBefore ==
           get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty
        && request.resource.data.stockBefore >= request.resource.data.quantity
        && request.resource.data.unitPriceMinor ==
           get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.priceMinor
        && request.resource.data.totalMinor ==
           request.resource.data.unitPriceMinor * request.resource.data.quantity
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty ==
           request.resource.data.stockBefore - request.resource.data.quantity
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementId == saleId
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementType == 'sale'
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.updatedAt == request.time;
      allow update: if canSellInventory()
        && ('orderId' in resource.data)
        && (canManageInventory() || resource.data.sellerUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['paidMinor', 'paymentStatus', 'lastPaymentId', 'lastPaymentAt'])
        && request.resource.data.paidMinor is int
        && request.resource.data.paidMinor > resource.data.paidMinor
        && request.resource.data.paidMinor <= resource.data.totalMinor
        && request.resource.data.paymentStatus ==
           (request.resource.data.paidMinor == resource.data.totalMinor
              ? 'paid' : 'partially_paid')
        && request.resource.data.lastPaymentId is string
        && request.resource.data.lastPaymentId != resource.data.lastPaymentId
        && request.resource.data.lastPaymentAt == request.time
        && !exists(/databases/$(database)/documents/inventory_payments/$(request.resource.data.lastPaymentId))
        && getAfter(/databases/$(database)/documents/inventory_payments/$(request.resource.data.lastPaymentId)).data.saleId == saleId
        && getAfter(/databases/$(database)/documents/inventory_payments/$(request.resource.data.lastPaymentId)).data.collectedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/inventory_payments/$(request.resource.data.lastPaymentId)).data.amountMinor ==
           request.resource.data.paidMinor - resource.data.paidMinor;
      allow delete: if false;
    }

    // Every subsequent collection is append-only and must move the linked
    // receipt balance by the exact same amount in the same transaction.
    match /inventory_payments/{paymentId} {
      allow get,list: if parentFeature(resource.data.customerId,'parent_fees');
      allow get, list: if canManageInventory() || isPrincipal()
        || (inventoryRole('canteen_seller')
            && resource.data.sellerUid == request.auth.uid);
      allow create: if canSellInventory()
        && request.resource.data.keys().hasOnly([
          'paymentId', 'saleId', 'orderId', 'sellerUid',
          'customerId', 'customerName', 'amountMinor', 'paidBeforeMinor',
          'balanceAfterMinor', 'method', 'collectedBy', 'collectedAt'])
        && request.resource.data.paymentId == paymentId
        && request.resource.data.saleId is string
        && exists(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId))
        && request.resource.data.collectedBy == request.auth.uid
        && request.resource.data.collectedAt == request.time
        && request.resource.data.method in
           ['Cash', 'Easypaisa', 'JazzCash', 'Bank Transfer', 'Other']
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.paidBeforeMinor ==
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.paidMinor
        && request.resource.data.amountMinor <=
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.totalMinor -
           request.resource.data.paidBeforeMinor
        && request.resource.data.orderId ==
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.orderId
        && request.resource.data.sellerUid ==
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.sellerUid
        && (canManageInventory() || request.resource.data.sellerUid == request.auth.uid)
        && request.resource.data.customerId ==
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.customerId
        && request.resource.data.customerName ==
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.customerName
        && request.resource.data.balanceAfterMinor ==
           get(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.totalMinor -
           request.resource.data.paidBeforeMinor - request.resource.data.amountMinor
        && getAfter(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.paidMinor ==
           request.resource.data.paidBeforeMinor + request.resource.data.amountMinor
        && getAfter(/databases/$(database)/documents/inventory_sales/$(request.resource.data.saleId)).data.lastPaymentId == paymentId;
      allow update, delete: if false;
    }

    // Never store supplier or purchase costs on inventory_items: sellers
    // are allowed to read those public stock/price documents.
    match /inventory_costs/{itemId} {
      allow get, list: if canManageInventory();
      allow create: if canManageInventory()
        && request.resource.data.keys().hasOnly([
           'sku', 'department', 'unitCostMinor', 'currency',
           'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.sku == itemId
        && itemId.matches('^[A-Z0-9_-]{3,32}$')
        && request.resource.data.department in ['canteen', 'stationery']
        && request.resource.data.unitCostMinor is int
        && request.resource.data.unitCostMinor > 0
        && request.resource.data.unitCostMinor <= 100000000000
        && request.resource.data.currency == 'PKR'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/inventory_items/$(itemId)).data.department ==
            request.resource.data.department;
      allow update: if canManageInventory()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'unitCostMinor', 'updatedBy', 'updatedAt'])
        && request.resource.data.unitCostMinor is int
        && request.resource.data.unitCostMinor > 0
        && request.resource.data.unitCostMinor <= 100000000000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Supplier costs stay private from sellers. Normal purchases must
    // reconcile with stock increments. An initial valued opening receipt is
    // recorded alongside the product's existing opening adjustment.
    match /inventory_purchases/{purchaseId} {
      allow get, list: if canManageInventory();
      allow create: if canManageInventory()
        && request.resource.data.keys().hasOnly([
          'purchaseId', 'itemId', 'itemName', 'quantity', 'stockBefore',
          'unitCostMinor', 'totalCostMinor', 'supplier', 'invoice', 'currency',
          'recordedBy', 'purchasedAt', 'recordedAt', 'source'])
        && request.resource.data.purchaseId == purchaseId
        && request.resource.data.itemId is string
        && request.resource.data.get('source', 'receipt') in ['opening', 'receipt']
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 100000
        && request.resource.data.unitCostMinor is int
        && request.resource.data.unitCostMinor >= 0
        && request.resource.data.unitCostMinor <= 100000000000
        && request.resource.data.totalCostMinor ==
           request.resource.data.quantity * request.resource.data.unitCostMinor
        && request.resource.data.supplier is string
        && request.resource.data.supplier.size() > 0
        && request.resource.data.supplier.size() <= 100
        && request.resource.data.invoice is string
        && request.resource.data.invoice.size() <= 80
        && request.resource.data.currency == 'PKR'
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.purchasedAt == request.time
        && request.resource.data.recordedAt == request.time
        && (
          (request.resource.data.get('source', 'receipt') == 'receipt'
            && exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
            && request.resource.data.itemName ==
               get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.name
            && request.resource.data.stockBefore ==
               get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty ==
               request.resource.data.stockBefore + request.resource.data.quantity
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementId == purchaseId
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementType == 'purchase'
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.updatedBy == request.auth.uid)
          ||
          (request.resource.data.get('source', 'receipt') == 'opening'
            && !exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
            && request.resource.data.stockBefore == 0
            && request.resource.data.supplier == 'Opening stock'
            && request.resource.data.itemName ==
               getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.name
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty ==
               request.resource.data.quantity
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementType == 'opening'
            && getAfter(/databases/$(database)/documents/inventory_adjustments/$(getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementId)).data.reason == 'opening'
            && getAfter(/databases/$(database)/documents/inventory_costs/$(request.resource.data.itemId)).data.unitCostMinor ==
               request.resource.data.unitCostMinor)
        );
      allow update, delete: if false;
    }

    match /inventory_adjustments/{adjustmentId} {
      allow get, list: if canManageInventory();
      allow create: if canManageInventory()
        && request.resource.data.keys().hasOnly([
          'adjustmentId', 'itemId', 'itemName', 'delta', 'stockBefore',
          'reason', 'notes', 'recordedBy', 'recordedAt'])
        && request.resource.data.adjustmentId == adjustmentId
        && request.resource.data.itemId is string
        && request.resource.data.itemId is string
        && (
          (exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
            && request.resource.data.itemName ==
               get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.name)
          ||
          (!exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
            && request.resource.data.itemName ==
               getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.name)
        )
        && request.resource.data.delta is int
        && request.resource.data.delta != 0
        && request.resource.data.delta >= -100000
        && request.resource.data.delta <= 100000
        && request.resource.data.stockBefore ==
           (exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
             ? get(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty
             : 0)
        && request.resource.data.stockBefore + request.resource.data.delta >= 0
        && request.resource.data.reason in
            ['opening', 'damage', 'expired', 'wastage', 'return', 'correction']
        && (request.resource.data.reason != 'opening'
            || (!exists(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId))
                && request.resource.data.stockBefore == 0
                && request.resource.data.delta > 0))
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 250
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recordedAt == request.time
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.stockQty ==
           request.resource.data.stockBefore + request.resource.data.delta
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementId == adjustmentId
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementType ==
           (request.resource.data.reason == 'opening' ? 'opening' : 'adjustment')
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.updatedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else stays inaccessible until role-specific modules are
    // implemented and reviewed. DO NOT add a broad match allow rule here.
    // Direct private messages use the same storage as the optional portal
    // HTTPS backend. Only school administrators and the active thread
    // participant may read messages. A teacher cannot impersonate staff.
    function schoolMessageAdmin() {
      return isOwner() || (isPrincipal() && accountPermission('messages'));
    }
    function eligibleMessageAccount(uid) {
      let u=get(/databases/$(database)/documents/users/$(uid)).data;
      return u.active == true && u.get('removed',false) == false
        && u.role in ['parent','teacher'] && u.get('permissions',{}).get('messages',true) == true;
    }
    function messageThreadAccess(uid) {
      return request.auth != null && eligibleMessageAccount(uid)
        && (schoolMessageAdmin() || request.auth.uid == uid);
    }
    function chatWritable(uid) {
      let p=/databases/$(database)/documents/chat_cleanup/current;
      return !exists(p) || get(p).data.status == 'done'
        || (get(p).data.scope == 'thread' && get(p).data.threadUid != uid);
    }
    match /chat_cleanup/current {
      allow get: if isOwner();
      allow create,update: if isOwner()
        && (!exists(/databases/$(database)/documents/chat_cleanup/current) || resource.data.status == 'done')
        && request.resource.data.keys().hasOnly(['scope','threadUid','status','requestedAt'])
        && request.resource.data.status == 'queued'
        && request.resource.data.requestedAt == request.time
        && ((request.resource.data.scope == 'all' && request.resource.data.threadUid == '')
          || (request.resource.data.scope == 'thread' && request.resource.data.threadUid is string
            && request.resource.data.threadUid.matches('^[A-Za-z0-9_-]{1,128}$')));
      allow list,delete: if false;
    }

    // Voice-only office calls. One replaceable session per caller; accepting
    // is an atomic claim, so two office devices cannot answer the same call.
    function callCaller(uid) {
      return request.auth != null && request.auth.uid == uid && eligibleMessageAccount(uid);
    }
    function newOfficeCall(uid) {
      let d=request.resource.data;
      return callCaller(uid) && d.keys().hasOnly(['callerUid','callId','status','offer','createdAt','updatedAt','expiresAt'])
        && d.callerUid == uid && d.callId is string && d.callId.size() == 20
        && d.status == 'ringing' && d.offer is string && d.offer.size() > 0 && d.offer.size() <= 60000
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.expiresAt is timestamp && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(90,'s');
    }
    function validOfficeCallUpdate(uid) {
      let old=resource.data;
      let d=request.resource.data;
      let changed=d.diff(old).affectedKeys();
      return d.updatedAt == request.time && (
        (schoolMessageAdmin() && old.status == 'ringing' && old.expiresAt > request.time
          && d.status == 'answering' && d.acceptedBy == request.auth.uid
          && changed.hasOnly(['status','acceptedBy','updatedAt','expiresAt'])
          && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(60,'m'))
        || (schoolMessageAdmin() && old.status == 'answering' && old.acceptedBy == request.auth.uid
          && old.expiresAt > request.time && d.status == 'connected'
          && d.answer is string && d.answer.size() > 0 && d.answer.size() <= 60000
          && changed.hasOnly(['status','answer','updatedAt']))
        || ((callCaller(uid) || (schoolMessageAdmin() &&
          (old.status == 'ringing' || old.get('acceptedBy','') == request.auth.uid)))
          && old.status in ['ringing','answering','connected']
          && d.status in ['ended','declined','missed']
          && changed.hasOnly(['status','updatedAt','offer','answer'])
          && !('offer' in d) && !('answer' in d))
      );
    }
    match /office_calls/{uid} {
      allow get: if callCaller(uid) || schoolMessageAdmin();
      allow list: if schoolMessageAdmin();
      allow create: if newOfficeCall(uid);
      allow update: if (newOfficeCall(uid) && (resource.data.status in ['ended','declined','missed']
        || resource.data.expiresAt <= request.time)) || validOfficeCallUpdate(uid);
      allow delete: if false;
    }


    function callV2Target(d) {
      return (d.targetUid == 'office' && schoolMessageAdmin())
        || (request.auth != null && d.targetUid == request.auth.uid && eligibleMessageAccount(request.auth.uid));
    }
    function callV2Access(d) {
      return request.auth != null && ((d.callerUid == request.auth.uid
        && (schoolMessageAdmin() || eligibleMessageAccount(request.auth.uid))) || callV2Target(d));
    }
    function callV2Create(id) {
      let d=request.resource.data;
      return request.auth != null && d.callerUid == request.auth.uid && d.callId == id && id.size() == 20
        && d.keys().hasOnly(['callerUid','targetUid','threadUid','callId','status','offer','createdAt','updatedAt','expiresAt','historyDueAt'])
        && ((eligibleMessageAccount(request.auth.uid) && d.targetUid == 'office' && d.threadUid == request.auth.uid)
          || (schoolMessageAdmin() && d.targetUid == d.threadUid && eligibleMessageAccount(d.targetUid)))
        && chatWritable(d.threadUid) && d.status == 'ringing'
        && d.offer is string && d.offer.size() > 0 && d.offer.size() <= 60000
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.expiresAt is timestamp && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(90,'s') && d.historyDueAt == d.expiresAt;
    }
    function callV2Update() {
      let old=resource.data;
      let d=request.resource.data;
      let changed=d.diff(old).affectedKeys();
      return callV2Access(old) && d.updatedAt == request.time && (
        (callV2Target(old) && old.status == 'ringing' && old.expiresAt > request.time
          && d.status == 'answering' && d.acceptedBy == request.auth.uid
          && changed.hasOnly(['status','acceptedBy','updatedAt','expiresAt','historyDueAt'])
          && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(60,'m')
          && d.historyDueAt == d.expiresAt)
        || (callV2Target(old) && old.status == 'answering' && old.acceptedBy == request.auth.uid
          && old.expiresAt > request.time && d.status == 'connected'
          && d.answer is string && d.answer.size() > 0 && d.answer.size() <= 60000
          && changed.hasOnly(['status','answer','updatedAt']))
        || (old.status == 'connected' && old.get('mediaConnectedAt',null) == null
          && (old.callerUid == request.auth.uid || old.acceptedBy == request.auth.uid)
          && d.mediaConnectedAt == request.time && changed.hasOnly(['mediaConnectedAt','updatedAt']))
        || ((old.callerUid == request.auth.uid || (callV2Target(old) &&
          (old.status == 'ringing' || old.get('acceptedBy','') == request.auth.uid)))
          && old.status in ['ringing','answering','connected']
          && d.status in ['ended','declined','missed']
          && changed.hasOnly(['status','updatedAt','historyDueAt','offer','answer'])
          && d.historyDueAt == request.time && !('offer' in d) && !('answer' in d))
      );
    }
    match /office_calls_v2/{id} {
      allow get,list: if callV2Access(resource.data);
      allow create: if callV2Create(id);
      allow update: if callV2Update();
      allow delete: if false;
    }

    function validMessageThread(uid) {
      let d=request.resource.data;
      let u=get(/databases/$(database)/documents/users/$(uid)).data;
      return d.keys().hasOnly(['uid','updatedAt','name','role'])
        && d.uid == uid && d.updatedAt == request.time
        && d.get('name','') == u.get('displayName','')
        && d.role == u.role;
    }
    function activeChatUser() {
      return request.auth != null && (isOwner() ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('removed',false) == false));
    }
    match /account_pictures/{uid} {
      allow get: if activeChatUser() && (request.auth.uid == uid || schoolMessageAdmin()
        || (eligibleMessageAccount(request.auth.uid) && uid == 'tQt6vca2zuagZipvknBwcmSRcrc2')
        || (eligibleMessageAccount(request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(uid)).data.role == 'principal'
          && get(/databases/$(database)/documents/users/$(uid)).data.active == true
          && get(/databases/$(database)/documents/users/$(uid)).data.get('removed',false) == false
          && get(/databases/$(database)/documents/users/$(uid)).data.get('permissions',{}).get('messages',true) == true));
      allow list: if isOwner();
      allow create,update: if activeChatUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['image','updatedAt'])
        && request.resource.data.image is bytes && request.resource.data.image.size() <= 102400
        && request.resource.data.updatedAt == request.time;
      allow delete: if activeChatUser() && request.auth.uid == uid;
    }
    match /chat_preferences/{uid} {
      allow read: if activeChatUser() && request.auth.uid == uid;
      allow list: if isOwner();
      allow create,update: if activeChatUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['background','outgoing','incoming'])
        && request.resource.data.background is int && request.resource.data.outgoing is int
        && request.resource.data.incoming is int
        && request.resource.data.background >= 0 && request.resource.data.background <= 4294967295
        && request.resource.data.outgoing >= 0 && request.resource.data.outgoing <= 4294967295
        && request.resource.data.incoming >= 0 && request.resource.data.incoming <= 4294967295;
      allow delete: if activeChatUser() && request.auth.uid == uid;
    }
    function validChatPayload(d) {
      return d.text is string && d.text.size() <= 2000
        && d.get('kind','text') in ['text','sticker','file','voice']
        && (d.get('kind','text') == 'file'
          ? (d.attachment is map && d.attachment.keys().hasOnly(['name','bytes','contentType'])
            && d.attachment.name is string && d.attachment.name.size() <= 120
            && d.attachment.bytes is bytes && d.attachment.bytes.size() > 0 && d.attachment.bytes.size() <= 524288
            && d.attachment.contentType in ['application/pdf','image/jpeg','image/png','image/webp','text/plain'])
          : (d.get('kind','text') == 'voice'
            ? (d.text == '' && d.attachment is map
              && d.attachment.keys().hasOnly(['durationMs','contentType'])
              && d.attachment.durationMs is int && d.attachment.durationMs > 0
              && d.attachment.durationMs <= 240000 && d.attachment.contentType == 'audio/mp4')
            : (!('attachment' in d) && d.text.size() > 0)));
    }
    function canReceiveMessageAlerts() {
      return request.auth != null && (schoolMessageAdmin() || eligibleMessageAccount(request.auth.uid));
    }
    match /message_alerts/{id} {
      allow get,list: if canReceiveMessageAlerts() && (
        (schoolMessageAdmin() && resource.data.fromSchool == false)
        || (resource.data.fromSchool == true && resource.data.threadUid == request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['threadUid','senderUid','fromSchool','createdAt','pushPending'])
        && request.resource.data.threadUid is string
        && messageThreadAccess(request.resource.data.threadUid) && chatWritable(request.resource.data.threadUid)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.fromSchool == schoolMessageAdmin()
        && request.resource.data.createdAt == request.time
        && request.resource.data.pushPending == true
        && !exists(/databases/$(database)/documents/portal_threads/$(request.resource.data.threadUid)/messages/$(id))
        && getAfter(/databases/$(database)/documents/portal_threads/$(request.resource.data.threadUid)/messages/$(id)).data.senderUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/portal_threads/$(request.resource.data.threadUid)/messages/$(id)).data.createdAt == request.time;
      allow update,delete: if false;
    }
    match /message_alert_reads/{uid} {
      allow get: if canReceiveMessageAlerts() && request.auth.uid == uid;
      allow create,update: if canReceiveMessageAlerts() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['readThrough'])
        && request.resource.data.readThrough == request.time;
      allow delete: if false;
    }
    match /push_devices/{token} {
      allow get,delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Tokens are high entropy and never listed to clients. A new login on
      // the same installation can replace its registration.
      allow create,update: if canReceiveMessageAlerts()
        && token.size() > 20 && token.size() <= 512
        && request.resource.data.keys().hasOnly(['uid','updatedAt','callChannel'])
        && request.resource.data.get('callChannel','school_calls') is string
        && request.resource.data.get('callChannel','school_calls').matches('^school_calls[A-Za-z0-9_]{0,80}
        && request.resource.data.updatedAt == request.time;
      allow list: if false;
    }
    match /voice_settings/global {
      allow get: if canReceiveMessageAlerts();
      allow create,update: if isOwner()
        && request.resource.data.keys().hasOnly(['mode','updatedAt'])
        && request.resource.data.mode in ['played','7days','14days']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function voiceJob(messageId,uid) {
      let j=get(/databases/$(database)/documents/voice_jobs/$(messageId)).data;
      return j.threadUid == uid && j.senderUid == request.auth.uid && j.ready == true
        && j.expiresAt > request.time;
    }
    match /voice_jobs/{messageId} {
      allow get: if messageThreadAccess(resource.data.threadUid);
      allow list,create,delete: if false;
      allow update: if messageThreadAccess(resource.data.threadUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        && request.resource.data.expiresAt == request.time
        && (
          (resource.data.mode == 'played'
            && getAfter(/databases/$(database)/documents/portal_threads/$(resource.data.threadUid)/messages/$(messageId)).data.get('readAt',null) == request.time
            && getAfter(/databases/$(database)/documents/portal_threads/$(resource.data.threadUid)/messages/$(messageId)).data.senderUid != request.auth.uid)
          || (resource.data.senderUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/portal_threads/$(resource.data.threadUid)/messages/$(messageId)).data.get('deleted',false) == true)
        );
    }
    function validMessageReceipt(uid) {
      let old=resource.data;
      let next=request.resource.data;
      return messageThreadAccess(uid) && old.senderUid != request.auth.uid
        && old.fromSchool != schoolMessageAdmin()
        && old.get('deleted',false) == false
        && next.diff(old).affectedKeys().hasOnly(['deliveredAt','readAt'])
        && (next.get('deliveredAt',null) == old.get('deliveredAt',null)
          || (old.get('deliveredAt',null) == null && next.deliveredAt == request.time))
        && (next.get('readAt',null) == old.get('readAt',null)
          || (old.get('readAt',null) == null && next.readAt == request.time
            && next.get('deliveredAt',null) != null));
    }
    match /portal_threads/{uid} {
      allow get: if schoolMessageAdmin() || messageThreadAccess(uid);
      allow list: if schoolMessageAdmin();
      allow create,update: if messageThreadAccess(uid) && chatWritable(uid) && validMessageThread(uid);
      allow delete: if false;
      match /messages/{messageId} {
        allow get,list: if messageThreadAccess(uid);
        allow create: if messageThreadAccess(uid) && chatWritable(uid)
          && request.resource.data.keys().hasOnly(['text','senderUid','fromSchool','createdAt','kind','attachment'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.fromSchool == schoolMessageAdmin()
          && request.resource.data.createdAt == request.time
          && validChatPayload(request.resource.data)
          && (request.resource.data.get('kind','text') != 'voice' || voiceJob(messageId,uid))
          && getAfter(/databases/$(database)/documents/portal_threads/$(uid)).data.uid == uid;
        allow update: if validMessageReceipt(uid);
        // Only original sender can replace content with a tombstone.
        allow update: if messageThreadAccess(uid) && resource.data.senderUid == request.auth.uid
          && resource.data.get('deleted',false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','attachment','kind','deleted','deletedAt','voiceRetracted'])
          && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time
          && request.resource.data.get('voiceRetracted',false) == (resource.data.get('kind','text') == 'voice')
          && request.resource.data.text == '' && request.resource.data.kind == 'text'
          && !('attachment' in request.resource.data);
        allow delete: if false;
      }
      match /hidden/{viewer}/items/{messageId} {
        allow read,delete: if messageThreadAccess(uid) && request.auth.uid == viewer;
        allow create,update: if messageThreadAccess(uid) && chatWritable(uid) && request.auth.uid == viewer
          && request.resource.data.keys().hasOnly(['hiddenAt'])
          && request.resource.data.hiddenAt == request.time;
      }
      match /scheduled/{messageId} {
        allow get,list: if messageThreadAccess(uid) && resource.data.senderUid == request.auth.uid;
        allow create: if messageThreadAccess(uid) && chatWritable(uid)
          && request.resource.data.keys().hasOnly(['text','kind','senderUid','fromSchool','sendAt','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.fromSchool == schoolMessageAdmin()
          && request.resource.data.createdAt == request.time
          && request.resource.data.sendAt is timestamp && request.resource.data.sendAt > request.time
          && request.resource.data.sendAt < request.time + duration.value(366,'d')
          && request.resource.data.kind in ['text','sticker'] && validChatPayload(request.resource.data);
        allow delete: if messageThreadAccess(uid) && resource.data.senderUid == request.auth.uid;
        allow update: if false;
      }
    }


    function linkedParent(studentId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && u.active == true && u.get('removed',false) == false
        && u.role == 'parent' && studentId in u.get('linkedStudentIds',[]);
    }
    function parentFeature(studentId,key) {
      return request.auth != null && linkedParent(studentId) && accountPermission(key);
    }
    function admittedChild(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.get('status','admitted') == 'admitted';
    }
    // Photo-only projection, checked against the current private source.
    match /student_photo_directory/{studentId} {
      function source() {
        return get(/databases/$(database)/documents/students/$(studentId)).data;
      }
      allow get: if canManageAdmissions() || (
        resource.data.photoPath == source().get('photoPath','')
        && source().get('status','admitted') == 'admitted'
        && (canManageExams()
          || (source().get('active',true) == true &&
            (canSellInventory()
              || (hasTeacherClassAccess(source().classId) && accountPermission('teacher_academics'))
              || canMarkClassAttendance(source().classId)))
          || parentFeature(studentId,'parent_profile')
          || parentFeature(studentId,'parent_documents')));
      allow list: if isOwner();
      allow create,update: if canManageAdmissions()
        && request.resource.data.keys().hasOnly(['photoPath'])
        && request.resource.data.photoPath is string
        && request.resource.data.photoPath ==
          getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('photoPath','');
      allow delete: if canManageAdmissions();
    }
    match /parent_children/{studentId} {
      allow get: if canManageAdmissions() || (linkedParent(studentId) && admittedChild(studentId));
      allow list: if canManageAdmissions();
      allow create,update: if canManageAdmissions() && request.resource.data.keys().hasOnly(['fullName','classId','className','historyClassIds']);
      allow delete: if false;
    }
    match /parent_profiles/{studentId} {
      allow get: if canManageAdmissions() || (parentFeature(studentId,'parent_profile') && admittedChild(studentId));
      allow list: if canManageAdmissions();
      allow create,update: if canManageAdmissions() && request.resource.data.keys().hasOnly(
        ['fullName','admissionNo','rollNo','gender','status','active','dateOfBirth','nationality','classId','admissionDate']);
      allow delete: if false;
    }
    match /parent_documents/{studentId} {
      // A stale projection must never authorize a removed file.
      allow get: if canManageAdmissions() || (parentFeature(studentId,'parent_documents') && admittedChild(studentId)
        && resource.data.photoPath == get(/databases/$(database)/documents/students/$(studentId)).data.get('photoPath','')
        && resource.data.attachments == get(/databases/$(database)/documents/students/$(studentId)).data.get('attachments',{}));
      allow list: if canManageAdmissions();
      allow create,update: if canManageAdmissions() && request.resource.data.keys().hasOnly(['photoPath','attachments'])
        && request.resource.data.photoPath is string && request.resource.data.attachments is map;
      allow delete: if false;
    }
    match /parent_attendance/{studentId}/days/{dayId} {
      allow get,list: if canManageAdmissions() || parentFeature(studentId,'parent_attendance');
      allow create,update: if request.resource.data.keys().hasOnly(['studentId','classId','date','status'])
        && request.resource.data.studentId == studentId
        && (canManageAdmissions() || canMarkClassAttendance(request.resource.data.classId))
        && request.resource.data.studentId == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.studentId
        && request.resource.data.classId == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.classId
        && request.resource.data.date == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.date
        && request.resource.data.status == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.status;
      allow delete: if false;
    }
    function childClass(studentId,classId) {
      return admittedChild(studentId) && (get(/databases/$(database)/documents/students/$(studentId)).data.get('classId','') == classId
        || exists(/databases/$(database)/documents/class_rosters/$(classId)/students/$(studentId)));
    }
    match /parent_class_grants/{uid}/classes/{classId} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create,update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId'])
        && parentFeature(request.resource.data.studentId,'parent_exams')
        && childClass(request.resource.data.studentId,classId);
      allow list,delete: if false;
    }
    // Historical snapshots are written only by admissions administrators and
    // remain private to the linked child, not the entire former class.
    match /parent_classwork_history/{studentId}/items/{workId} {
      allow get,list: if canManageAdmissions() || parentFeature(studentId,'parent_exams');
      allow create,update: if canManageAdmissions()
        && request.resource.data.keys().hasOnly(['title','subject','instructions','dueDate','kind','classId','active'])
        && childClass(studentId,request.resource.data.classId);
      allow delete: if false;
    }
    function parentCurrentClassAccess(classId) {
      let grant=get(/databases/$(database)/documents/parent_class_grants/$(request.auth.uid)/classes/$(classId)).data;
      return parentFeature(grant.studentId,'parent_exams') && admittedChild(grant.studentId)
        && get(/databases/$(database)/documents/students/$(grant.studentId)).data.classId == classId;
    }
    function parentClassAccess(classId) {
      let grant=get(/databases/$(database)/documents/parent_class_grants/$(request.auth.uid)/classes/$(classId)).data;
      return parentFeature(grant.studentId,'parent_exams') && childClass(grant.studentId,classId);
    }
    function validParentPaper(classId,examId) {
      let p=get(/databases/$(database)/documents/examinations/$(examId)).data;
      let d=request.resource.data;
      return p.classId == classId && (canManageExams() || examTeacherAuthorized(p))
        && d.keys().hasOnly(['classId','title','sessionTitle','kind','category','subject','examDate','paperType',
          'startMinute','endMinute','maxMarks','resultStatus','active','cycleId','rescheduleReason'])
        && d.get('classId',null) == p.get('classId',null)
        && d.get('title',null) == p.get('title',null)
        && d.get('sessionTitle',null) == p.get('sessionTitle',null)
        && d.get('kind',null) == p.get('kind',null)
        && d.get('category',null) == p.get('category',null)
        && d.get('subject',null) == p.get('subject',null)
        && d.get('examDate',null) == p.get('examDate',null)
        && d.get('paperType',null) == p.get('paperType',null)
        && d.get('startMinute',null) == p.get('startMinute',null)
        && d.get('endMinute',null) == p.get('endMinute',null)
        && d.get('maxMarks',null) == p.get('maxMarks',null)
        && d.get('resultStatus',null) == p.get('resultStatus',null)
        && d.get('active',null) == p.get('active',null)
        && d.get('cycleId',null) == p.get('cycleId',null)
        && d.get('rescheduleReason',null) == p.get('rescheduleReason',null);
    }
    match /parent_class_schedules/{classId}/papers/{examId} {
      allow get,list: if canManageExams() || (request.auth != null && parentClassAccess(classId));
      allow create,update: if request.auth != null && validParentPaper(classId,examId);
      allow delete: if false;
    }
    match /parent_term_summaries/{cycleId} {
      allow get: if canManageExams() || (request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && accountPermission('parent_exams'));
      allow list: if canManageExams();
      allow create,update: if canManageExams()
        && request.resource.data.keys().hasOnly(['status','category','startDate','endDate','excludedDates']);
      allow delete: if false;
    }

    // Only the owner can run the cross-collection backfill. This does not
    // grant parents access to a collection-group of private marks.
    match /{path=**}/marks/{markId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/scheduled/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/subjects/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/students/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/messages/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/days/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/items/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/papers/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/classes/{backupId} {
      allow list: if isOwner();
    }
    // Container documents may not exist even when nested records do.
    // Explicitly permit the owner to enumerate the known container roots.
    match /{backupCollection}/{backupId} {
      allow list: if isOwner() && backupCollection in [
        'finance_scheduler_runtime','finance_dashboard_preferences',
        'class_rosters','parent_attendance','parent_class_grants',
        'parent_classwork_history','parent_class_schedules'
      ];
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow list: if false;
    }
    match /voice_settings/global {
      allow get: if canReceiveMessageAlerts();
      allow create,update: if isOwner()
        && request.resource.data.keys().hasOnly(['mode','updatedAt'])
        && request.resource.data.mode in ['played','7days','14days']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function voiceJob(messageId,uid) {
      let j=get(/databases/$(database)/documents/voice_jobs/$(messageId)).data;
      return j.threadUid == uid && j.senderUid == request.auth.uid && j.ready == true
        && j.expiresAt > request.time;
    }
    match /voice_jobs/{messageId} {
      allow get: if messageThreadAccess(resource.data.threadUid);
      allow list,create,delete: if false;
      allow update: if messageThreadAccess(resource.data.threadUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        && request.resource.data.expiresAt == request.time
        && (
          (resource.data.mode == 'played'
            && getAfter(/databases/$(database)/documents/portal_threads/$(resource.data.threadUid)/messages/$(messageId)).data.get('readAt',null) == request.time
            && getAfter(/databases/$(database)/documents/portal_threads/$(resource.data.threadUid)/messages/$(messageId)).data.senderUid != request.auth.uid)
          || (resource.data.senderUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/portal_threads/$(resource.data.threadUid)/messages/$(messageId)).data.get('deleted',false) == true)
        );
    }
    function validMessageReceipt(uid) {
      let old=resource.data;
      let next=request.resource.data;
      return messageThreadAccess(uid) && old.senderUid != request.auth.uid
        && old.fromSchool != schoolMessageAdmin()
        && old.get('deleted',false) == false
        && next.diff(old).affectedKeys().hasOnly(['deliveredAt','readAt'])
        && (next.get('deliveredAt',null) == old.get('deliveredAt',null)
          || (old.get('deliveredAt',null) == null && next.deliveredAt == request.time))
        && (next.get('readAt',null) == old.get('readAt',null)
          || (old.get('readAt',null) == null && next.readAt == request.time
            && next.get('deliveredAt',null) != null));
    }
    match /portal_threads/{uid} {
      allow get: if schoolMessageAdmin() || messageThreadAccess(uid);
      allow list: if schoolMessageAdmin();
      allow create,update: if messageThreadAccess(uid) && chatWritable(uid) && validMessageThread(uid);
      allow delete: if false;
      match /messages/{messageId} {
        allow get,list: if messageThreadAccess(uid);
        allow create: if messageThreadAccess(uid) && chatWritable(uid)
          && request.resource.data.keys().hasOnly(['text','senderUid','fromSchool','createdAt','kind','attachment'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.fromSchool == schoolMessageAdmin()
          && request.resource.data.createdAt == request.time
          && validChatPayload(request.resource.data)
          && (request.resource.data.get('kind','text') != 'voice' || voiceJob(messageId,uid))
          && getAfter(/databases/$(database)/documents/portal_threads/$(uid)).data.uid == uid;
        allow update: if validMessageReceipt(uid);
        // Only original sender can replace content with a tombstone.
        allow update: if messageThreadAccess(uid) && resource.data.senderUid == request.auth.uid
          && resource.data.get('deleted',false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','attachment','kind','deleted','deletedAt','voiceRetracted'])
          && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time
          && request.resource.data.get('voiceRetracted',false) == (resource.data.get('kind','text') == 'voice')
          && request.resource.data.text == '' && request.resource.data.kind == 'text'
          && !('attachment' in request.resource.data);
        allow delete: if false;
      }
      match /hidden/{viewer}/items/{messageId} {
        allow read,delete: if messageThreadAccess(uid) && request.auth.uid == viewer;
        allow create,update: if messageThreadAccess(uid) && chatWritable(uid) && request.auth.uid == viewer
          && request.resource.data.keys().hasOnly(['hiddenAt'])
          && request.resource.data.hiddenAt == request.time;
      }
      match /scheduled/{messageId} {
        allow get,list: if messageThreadAccess(uid) && resource.data.senderUid == request.auth.uid;
        allow create: if messageThreadAccess(uid) && chatWritable(uid)
          && request.resource.data.keys().hasOnly(['text','kind','senderUid','fromSchool','sendAt','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.fromSchool == schoolMessageAdmin()
          && request.resource.data.createdAt == request.time
          && request.resource.data.sendAt is timestamp && request.resource.data.sendAt > request.time
          && request.resource.data.sendAt < request.time + duration.value(366,'d')
          && request.resource.data.kind in ['text','sticker'] && validChatPayload(request.resource.data);
        allow delete: if messageThreadAccess(uid) && resource.data.senderUid == request.auth.uid;
        allow update: if false;
      }
    }


    function linkedParent(studentId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && u.active == true && u.get('removed',false) == false
        && u.role == 'parent' && studentId in u.get('linkedStudentIds',[]);
    }
    function parentFeature(studentId,key) {
      return request.auth != null && linkedParent(studentId) && accountPermission(key);
    }
    function admittedChild(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.get('status','admitted') == 'admitted';
    }
    // Photo-only projection, checked against the current private source.
    match /student_photo_directory/{studentId} {
      function source() {
        return get(/databases/$(database)/documents/students/$(studentId)).data;
      }
      allow get: if canManageAdmissions() || (
        resource.data.photoPath == source().get('photoPath','')
        && source().get('status','admitted') == 'admitted'
        && (canManageExams()
          || (source().get('active',true) == true &&
            (canSellInventory()
              || (hasTeacherClassAccess(source().classId) && accountPermission('teacher_academics'))
              || canMarkClassAttendance(source().classId)))
          || parentFeature(studentId,'parent_profile')
          || parentFeature(studentId,'parent_documents')));
      allow list: if isOwner();
      allow create,update: if canManageAdmissions()
        && request.resource.data.keys().hasOnly(['photoPath'])
        && request.resource.data.photoPath is string
        && request.resource.data.photoPath ==
          getAfter(/databases/$(database)/documents/students/$(studentId)).data.get('photoPath','');
      allow delete: if canManageAdmissions();
    }
    match /parent_children/{studentId} {
      allow get: if canManageAdmissions() || (linkedParent(studentId) && admittedChild(studentId));
      allow list: if canManageAdmissions();
      allow create,update: if canManageAdmissions() && request.resource.data.keys().hasOnly(['fullName','classId','className','historyClassIds']);
      allow delete: if false;
    }
    match /parent_profiles/{studentId} {
      allow get: if canManageAdmissions() || (parentFeature(studentId,'parent_profile') && admittedChild(studentId));
      allow list: if canManageAdmissions();
      allow create,update: if canManageAdmissions() && request.resource.data.keys().hasOnly(
        ['fullName','admissionNo','rollNo','gender','status','active','dateOfBirth','nationality','classId','admissionDate']);
      allow delete: if false;
    }
    match /parent_documents/{studentId} {
      // A stale projection must never authorize a removed file.
      allow get: if canManageAdmissions() || (parentFeature(studentId,'parent_documents') && admittedChild(studentId)
        && resource.data.photoPath == get(/databases/$(database)/documents/students/$(studentId)).data.get('photoPath','')
        && resource.data.attachments == get(/databases/$(database)/documents/students/$(studentId)).data.get('attachments',{}));
      allow list: if canManageAdmissions();
      allow create,update: if canManageAdmissions() && request.resource.data.keys().hasOnly(['photoPath','attachments'])
        && request.resource.data.photoPath is string && request.resource.data.attachments is map;
      allow delete: if false;
    }
    match /parent_attendance/{studentId}/days/{dayId} {
      allow get,list: if canManageAdmissions() || parentFeature(studentId,'parent_attendance');
      allow create,update: if request.resource.data.keys().hasOnly(['studentId','classId','date','status'])
        && request.resource.data.studentId == studentId
        && (canManageAdmissions() || canMarkClassAttendance(request.resource.data.classId))
        && request.resource.data.studentId == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.studentId
        && request.resource.data.classId == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.classId
        && request.resource.data.date == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.date
        && request.resource.data.status == getAfter(/databases/$(database)/documents/attendance_days/$(dayId)/marks/$(studentId)).data.status;
      allow delete: if false;
    }
    function childClass(studentId,classId) {
      return admittedChild(studentId) && (get(/databases/$(database)/documents/students/$(studentId)).data.get('classId','') == classId
        || exists(/databases/$(database)/documents/class_rosters/$(classId)/students/$(studentId)));
    }
    match /parent_class_grants/{uid}/classes/{classId} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create,update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId'])
        && parentFeature(request.resource.data.studentId,'parent_exams')
        && childClass(request.resource.data.studentId,classId);
      allow list,delete: if false;
    }
    // Historical snapshots are written only by admissions administrators and
    // remain private to the linked child, not the entire former class.
    match /parent_classwork_history/{studentId}/items/{workId} {
      allow get,list: if canManageAdmissions() || parentFeature(studentId,'parent_exams');
      allow create,update: if canManageAdmissions()
        && request.resource.data.keys().hasOnly(['title','subject','instructions','dueDate','kind','classId','active'])
        && childClass(studentId,request.resource.data.classId);
      allow delete: if false;
    }
    function parentCurrentClassAccess(classId) {
      let grant=get(/databases/$(database)/documents/parent_class_grants/$(request.auth.uid)/classes/$(classId)).data;
      return parentFeature(grant.studentId,'parent_exams') && admittedChild(grant.studentId)
        && get(/databases/$(database)/documents/students/$(grant.studentId)).data.classId == classId;
    }
    function parentClassAccess(classId) {
      let grant=get(/databases/$(database)/documents/parent_class_grants/$(request.auth.uid)/classes/$(classId)).data;
      return parentFeature(grant.studentId,'parent_exams') && childClass(grant.studentId,classId);
    }
    function validParentPaper(classId,examId) {
      let p=get(/databases/$(database)/documents/examinations/$(examId)).data;
      let d=request.resource.data;
      return p.classId == classId && (canManageExams() || examTeacherAuthorized(p))
        && d.keys().hasOnly(['classId','title','sessionTitle','kind','category','subject','examDate','paperType',
          'startMinute','endMinute','maxMarks','resultStatus','active','cycleId','rescheduleReason'])
        && d.get('classId',null) == p.get('classId',null)
        && d.get('title',null) == p.get('title',null)
        && d.get('sessionTitle',null) == p.get('sessionTitle',null)
        && d.get('kind',null) == p.get('kind',null)
        && d.get('category',null) == p.get('category',null)
        && d.get('subject',null) == p.get('subject',null)
        && d.get('examDate',null) == p.get('examDate',null)
        && d.get('paperType',null) == p.get('paperType',null)
        && d.get('startMinute',null) == p.get('startMinute',null)
        && d.get('endMinute',null) == p.get('endMinute',null)
        && d.get('maxMarks',null) == p.get('maxMarks',null)
        && d.get('resultStatus',null) == p.get('resultStatus',null)
        && d.get('active',null) == p.get('active',null)
        && d.get('cycleId',null) == p.get('cycleId',null)
        && d.get('rescheduleReason',null) == p.get('rescheduleReason',null);
    }
    match /parent_class_schedules/{classId}/papers/{examId} {
      allow get,list: if canManageExams() || (request.auth != null && parentClassAccess(classId));
      allow create,update: if request.auth != null && validParentPaper(classId,examId);
      allow delete: if false;
    }
    match /parent_term_summaries/{cycleId} {
      allow get: if canManageExams() || (request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && accountPermission('parent_exams'));
      allow list: if canManageExams();
      allow create,update: if canManageExams()
        && request.resource.data.keys().hasOnly(['status','category','startDate','endDate','excludedDates']);
      allow delete: if false;
    }

    // Only the owner can run the cross-collection backfill. This does not
    // grant parents access to a collection-group of private marks.
    match /{path=**}/marks/{markId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/scheduled/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/subjects/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/students/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/messages/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/days/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/items/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/papers/{backupId} {
      allow list: if isOwner();
    }
    match /{backupPath=**}/classes/{backupId} {
      allow list: if isOwner();
    }
    // Container documents may not exist even when nested records do.
    // Explicitly permit the owner to enumerate the known container roots.
    match /{backupCollection}/{backupId} {
      allow list: if isOwner() && backupCollection in [
        'finance_scheduler_runtime','finance_dashboard_preferences',
        'class_rosters','parent_attendance','parent_class_grants',
        'parent_classwork_history','parent_class_schedules'
      ];
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
